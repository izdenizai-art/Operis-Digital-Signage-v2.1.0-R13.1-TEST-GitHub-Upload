[Unit]
Description=YAY Chromium Kiosk
After=yay-local-player.service systemd-user-sessions.service
Requires=yay-local-player.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=yay
Group=yay
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
PAMName=login
Environment=HOME=/home/yay
ExecStart=/usr/bin/xinit /usr/local/bin/yay-kiosk-session -- :0 -nolisten tcp vt1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
